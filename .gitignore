# ==========================================
# Thread & Style Monorepo .gitignore
# ==========================================

# 1. Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Build Output
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/

# 3. Environment & Secrets
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
service-account.json
credentials.json
# Allow tracking example environment configurations
!.env.example
!.env.local.example
!.env.development.example
!.env.production.example

# 4. Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 5. Framework Caches
.turbo/
**/.turbo/
.vite/
**/.vite/
.cache/
**/.cache/
.parcel-cache/
.vercel/
**/.vercel/

# 6. TypeScript
*.tsbuildinfo
next-env.d.ts

# 7. Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# 8. Python (if applicable)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 9. Local Databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# 10. Uploads & Runtime Generated Files
uploads/*
!uploads/.gitkeep

# 11. IDE & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# 12. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 13. Temporary Files
*.tmp
*.temp
tmp/
temp/
