# ==========================================
# Fantasy King Public Website Configuration
# ==========================================
VITE_SITE_URL=http://localhost:3000
VITE_WHATSAPP_NUMBER=+91 88380 66960

# ================================================================
# 1. Google Places API (New) — Google Maps Reviews (Server-Side)
# ================================================================
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_cloud_places_api_key
# Exact Place ID for FANTASY KING (auto-discovered if omitted):
GOOGLE_PLACE_ID=
# (or GOOGLE_PLACES_PLACE_ID=)

# ================================================================
# 2. Google Drive — OUR WORK Gallery (Admin Server-Side Only)
# ================================================================
GOOGLE_DRIVE_FOLDER_ID=1JaC8Vuq87FNMvzfQyN3NMqx2H-7Dd-lN

# Service Account credentials (if shared with service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Or optional API key (if folder is public / link-shared):
# GOOGLE_DRIVE_API_KEY=

# ================================================================
# 3. Google Sheets — Appointments Database (Admin Server-Side Only)
# ================================================================
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Appointments
# Optional Google Apps Script / Webhook URL:
# GOOGLE_SHEETS_WEBHOOK_URL=

# ================================================================
# 4. Google Business Profile — OAuth Management (Server-Side)
# ================================================================
# OAuth Web Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Stored automatically after visiting http://localhost:3000/api/google/auth:
# GOOGLE_REFRESH_TOKEN=
